class Block { //[I-S]LN=1;[I-E]
 //[I-S]LN=2;[I-E]
  int topFace; //[I-S]LN=3;[I-E]
  int sideFace; //[I-S]LN=4;[I-E]
  int bottomFace; //[I-S]LN=5;[I-E]
 //[I-S]LN=6;[I-E]
  public Block() {} //[I-S]LN=7;[I-E]
 //[I-S]LN=8;[I-E]
  public Block(int allFaces) { //[I-S]LN=9;[I-E]
    this.topFace = allFaces; //[I-S]LN=10;[I-E]
    this.sideFace = allFaces; //[I-S]LN=11;[I-E]
    this.bottomFace = allFaces; //[I-S]LN=12;[I-E]
  }  //[I-S]LN=13;[I-E]
    public Block(int topFace, int sideFace, int bottomFace) { //[I-S]LN=14;[I-E]
    this.topFace = topFace; //[I-S]LN=15;[I-E]
    this.sideFace = sideFace; //[I-S]LN=16;[I-E]
