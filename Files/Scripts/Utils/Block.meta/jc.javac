public class Block {

  int topFace;
  int sideFace;
  int bottomFace;

  public Block() {}

  public Block(int allFaces) {
    this.topFace = allFaces;
    this.sideFace = allFaces;
    this.bottomFace = allFaces;
  } 
    public Block(int topFace, int sideFace, int bottomFace) {
    this.topFace = topFace;
    this.sideFace = sideFace;
    this.bottomFace = bottomFace;
  } 
}