/** @Author */ //[I-S]LN=10;[I-E]
class VUtils { //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  public static void debugPattern(PatternGenerator p) { //[I-S]LN=13;[I-E]
    SpatialObject o = new SpatialObject("Pattern debug"); //[I-S]LN=14;[I-E]
    Material material = new Material(); //[I-S]LN=15;[I-E]
    material.setTexture("Texture", p.getTexture()); //[I-S]LN=16;[I-E]
    ModelRenderer mr = new ModelRenderer(); //[I-S]LN=17;[I-E]
    mr.vertex = Vertex.loadPrimitive(Vertex.CUBE); //[I-S]LN=18;[I-E]
    mr.material = material; //[I-S]LN=19;[I-E]
    o.addComponent(mr); //[I-S]LN=20;[I-E]
  } //[I-S]LN=21;[I-E]
} //[I-S]LN=22;[I-E]