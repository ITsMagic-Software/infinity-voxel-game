package JAVARuntime;

// Useful imports
import java.util.*;
import java.text.*;
import java.net.*;
import java.math.*;
import java.io.*;
import java.nio.*;

/** @Author */
public class Blocks extends Component {

  public static final int AIR = 0;
  public static final int GRASS = 1;
  public static final int ROCK = 2;
  public static final int DIRT = 3;
  public static final int LOG = 4;
  public static final int LEAVES = 5;
  public static final int SAND = 6;

  @Hide
  public List<Block> blocks = new ArrayList();

  public void start() {
    blocks.add(new Block(0)); // AIR
    blocks.add(new Block(1, 17, 3)); // GRASS
    blocks.add(new Block(2, 2, 2)); // ROCK
    blocks.add(new Block(3, 3, 3)); // DIRT
    blocks.add(new Block(5, 4, 5)); // LOG
    blocks.add(new Block(7)); // LEAVES
    blocks.add(new Block(8)); // SAND
  } 
}
