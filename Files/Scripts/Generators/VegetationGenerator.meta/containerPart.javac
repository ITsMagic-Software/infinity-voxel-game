/** //[I-S]LN=10;[I-E]
 * @Author  //[I-S]LN=11;[I-E]
*/ //[I-S]LN=12;[I-E]
class GenData { //[I-S]LN=13;[I-E]
 //[I-S]LN=14;[I-E]
    public int dirtLayerHeight = 4; //[I-S]LN=15;[I-E]
    public int beachLevel = 34; //[I-S]LN=16;[I-E]
    public int beachDepth = 3; //[I-S]LN=17;[I-E]
    public int caveDepthFromSurface = 8; //[I-S]LN=18;[I-E]
    public float caveThreshold = 0.62f; //[I-S]LN=19;[I-E]
    public int seed = 0; //[I-S]LN=20;[I-E]
 //[I-S]LN=21;[I-E]
    private PerlinNoise continentalNoise = new PerlinNoise(); //[I-S]LN=22;[I-E]
    private PerlinNoise hillNoise = new PerlinNoise(); //[I-S]LN=23;[I-E]
    private PerlinNoise detailNoise = new PerlinNoise(); //[I-S]LN=24;[I-E]
    private PerlinNoise mountainNoise = new PerlinNoise(); //[I-S]LN=25;[I-E]
    private PerlinNoise moistureNoise = new PerlinNoise(); //[I-S]LN=26;[I-E]
    private PerlinNoise temperatureNoise = new PerlinNoise(); //[I-S]LN=27;[I-E]
    private PerlinNoise forestNoise = new PerlinNoise(); //[I-S]LN=28;[I-E]
    private PerlinNoise caveNoise = new PerlinNoise(); //[I-S]LN=29;[I-E]
    private BiomeGenerator biomeGenerator = new BiomeGenerator(); //[I-S]LN=30;[I-E]
 //[I-S]LN=31;[I-E]
    public void start() { //[I-S]LN=32;[I-E]
        biomeGenerator.start(); //[I-S]LN=33;[I-E]
    } //[I-S]LN=34;[I-E]
 //[I-S]LN=35;[I-E]
    public int getGroundHeight(int x, int z, int minimalGroundHeight, int maxHillHeight, int baseHillWidth) { //[I-S]LN=36;[I-E]
        continentalNoise.setScale(baseHillWidth * 4); //[I-S]LN=37;[I-E]
        hillNoise.setScale(baseHillWidth); //[I-S]LN=38;[I-E]
        detailNoise.setScale(java.lang.Math.max(6, baseHillWidth / 3)); //[I-S]LN=39;[I-E]
        mountainNoise.setScale(baseHillWidth * 2); //[I-S]LN=40;[I-E]
 //[I-S]LN=41;[I-E]
        float continental = normalize(continentalNoise.noise(x + seedOffset(101), z - seedOffset(101))); //[I-S]LN=42;[I-E]
        float hills = normalize(hillNoise.noise(x + seedOffset(203), z - seedOffset(307))); //[I-S]LN=43;[I-E]
        float detail = normalize(detailNoise.noise(x - seedOffset(409), z + seedOffset(503))); //[I-S]LN=44;[I-E]
        float mountains = normalize(mountainNoise.noise(x + seedOffset(607), z + seedOffset(701))); //[I-S]LN=45;[I-E]
 //[I-S]LN=46;[I-E]
        mountains = java.lang.Math.max(0f, (mountains - 0.58f) / 0.42f); //[I-S]LN=47;[I-E]
        mountains *= mountains; //[I-S]LN=48;[I-E]
 //[I-S]LN=49;[I-E]
        float height = minimalGroundHeight; //[I-S]LN=50;[I-E]
        height += (continental - 0.5f) * maxHillHeight * 0.9f; //[I-S]LN=51;[I-E]
        height += hills * maxHillHeight * 0.75f; //[I-S]LN=52;[I-E]
        height += detail * 4f; //[I-S]LN=53;[I-E]
        height += mountains * maxHillHeight * 1.35f; //[I-S]LN=54;[I-E]
 //[I-S]LN=55;[I-E]
        return java.lang.Math.max(1, (int) height); //[I-S]LN=56;[I-E]
    } //[I-S]LN=57;[I-E]
 //[I-S]LN=58;[I-E]
    public int getBiome(int x, int z, int groundHeight) { //[I-S]LN=59;[I-E]
        moistureNoise.setScale(90); //[I-S]LN=60;[I-E]
        temperatureNoise.setScale(120); //[I-S]LN=61;[I-E]
 //[I-S]LN=62;[I-E]
        float moisture = normalize(moistureNoise.noise(x - seedOffset(809), z + seedOffset(907))); //[I-S]LN=63;[I-E]
        float temperature = normalize(temperatureNoise.noise(x + seedOffset(1009), z - seedOffset(1103))); //[I-S]LN=64;[I-E]
        return biomeGenerator.getBiome(moisture, temperature, groundHeight, beachLevel); //[I-S]LN=65;[I-E]
    } //[I-S]LN=66;[I-E]
 //[I-S]LN=67;[I-E]
    public boolean isBeach(int groundHeight) { //[I-S]LN=68;[I-E]
        return groundHeight <= beachLevel; //[I-S]LN=69;[I-E]
    } //[I-S]LN=70;[I-E]
 //[I-S]LN=71;[I-E]
    public boolean shouldPlaceTree(int x, int z, int groundHeight) { //[I-S]LN=72;[I-E]
        int biome = getBiome(x, z, groundHeight); //[I-S]LN=73;[I-E]
        if (biome == BiomeGenerator.BEACH || biome == BiomeGenerator.DESERT || biome == BiomeGenerator.MOUNTAINS) { //[I-S]LN=74;[I-E]
            return false; //[I-S]LN=75;[I-E]
        } //[I-S]LN=76;[I-E]
 //[I-S]LN=77;[I-E]
        forestNoise.setScale(18); //[I-S]LN=78;[I-E]
        float density = normalize(forestNoise.noise(x + seedOffset(1201), z - seedOffset(1301))); //[I-S]LN=79;[I-E]
        float limit = biome == BiomeGenerator.FOREST ? 0.64f : 0.82f; //[I-S]LN=80;[I-E]
        return density > limit; //[I-S]LN=81;[I-E]
    } //[I-S]LN=82;[I-E]
 //[I-S]LN=83;[I-E]
    public int getTreeHeight(int x, int z, int minHeight, int maxHeight) { //[I-S]LN=84;[I-E]
        int range = java.lang.Math.max(1, maxHeight - minHeight + 1); //[I-S]LN=85;[I-E]
        return minHeight + positiveHash(x, z, 17) % range; //[I-S]LN=86;[I-E]
    } //[I-S]LN=87;[I-E]
 //[I-S]LN=88;[I-E]
    public int getTreeRadius(int x, int z, int baseRadius) { //[I-S]LN=89;[I-E]
        return java.lang.Math.max(2, baseRadius + (positiveHash(x, z, 41) % 2)); //[I-S]LN=90;[I-E]
    } //[I-S]LN=91;[I-E]
 //[I-S]LN=92;[I-E]
    public boolean shouldCarveCave(int x, int y, int z, int groundHeight) { //[I-S]LN=93;[I-E]
        if (y >= groundHeight - caveDepthFromSurface || y < 4) { //[I-S]LN=94;[I-E]
            return false; //[I-S]LN=95;[I-E]
        } //[I-S]LN=96;[I-E]
 //[I-S]LN=97;[I-E]
        caveNoise.setScale(24); //[I-S]LN=98;[I-E]
        float horizontal = normalize(caveNoise.noise(x + seedOffset(1409), z - seedOffset(1511))); //[I-S]LN=99;[I-E]
        caveNoise.setScale(14); //[I-S]LN=100;[I-E]
        float vertical = normalize(caveNoise.noise(x + y * 3 + seedOffset(1601), z - y * 2 - seedOffset(1709))); //[I-S]LN=101;[I-E]
        return horizontal * 0.65f + vertical * 0.35f > caveThreshold; //[I-S]LN=102;[I-E]
    } //[I-S]LN=103;[I-E]
 //[I-S]LN=104;[I-E]
    public int positiveHash(int x, int z, int salt) { //[I-S]LN=105;[I-E]
        int h = x * 73428767 ^ z * 912931 ^ salt * 42349 ^ seed * 374761393; //[I-S]LN=106;[I-E]
        h ^= h >> 13; //[I-S]LN=107;[I-E]
        h *= 1274126177; //[I-S]LN=108;[I-E]
        h ^= h >> 16; //[I-S]LN=109;[I-E]
        return h & 0x7fffffff; //[I-S]LN=110;[I-E]
    } //[I-S]LN=111;[I-E]
 //[I-S]LN=112;[I-E]
    private float normalize(float v) { //[I-S]LN=113;[I-E]
        return (v + 1f) / 2f; //[I-S]LN=114;[I-E]
    } //[I-S]LN=115;[I-E]
 //[I-S]LN=116;[I-E]
    private int seedOffset(int salt) { //[I-S]LN=117;[I-E]
        int h = seed * 374761393 ^ salt * 668265263; //[I-S]LN=118;[I-E]
        h ^= h >> 13; //[I-S]LN=119;[I-E]
        h *= 1274126177; //[I-S]LN=120;[I-E]
        h ^= h >> 16; //[I-S]LN=121;[I-E]
        return 10000 + (h & 0x7fffffff) % 90000; //[I-S]LN=122;[I-E]
    } //[I-S]LN=123;[I-E]
} //[I-S]LN=124;[I-E]
