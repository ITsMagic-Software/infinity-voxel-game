class TerrainGenerator extends Component implements VoxelGeneratorListener { //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  private List<Generator> generators = new ArrayList(); //[I-S]LN=13;[I-E]
 //[I-S]LN=14;[I-E]
  @Order(idx = {0}) //[I-S]LN=15;[I-E]
  public int grassLayerHeight = 3; //[I-S]LN=16;[I-E]
 //[I-S]LN=17;[I-E]
  @Order(idx = {1}) //[I-S]LN=18;[I-E]
  public int minimalGroundHeight = 30; //[I-S]LN=19;[I-E]
 //[I-S]LN=20;[I-E]
  @Order(idx = {2}) //[I-S]LN=21;[I-E]
  public int maxHillHeight = 25; //[I-S]LN=22;[I-E]
 //[I-S]LN=23;[I-E]
  @Order(idx = {3}) //[I-S]LN=24;[I-E]
  public int baseHillWidth = 30; //[I-S]LN=25;[I-E]
 //[I-S]LN=26;[I-E]
  @Order(idx = {4}) //[I-S]LN=27;[I-E]
  public int seed = 0; //[I-S]LN=28;[I-E]
 //[I-S]LN=29;[I-E]
  private GenData genData = new GenData(); //[I-S]LN=30;[I-E]
  private boolean started = false; //[I-S]LN=31;[I-E]
  @Singleton //[I-S]LN=32;[I-E]
  private Blocks blocks; //[I-S]LN=33;[I-E]
 //[I-S]LN=34;[I-E]
  @Override //[I-S]LN=35;[I-E]
  public void start() { //[I-S]LN=36;[I-E]
    if (!started) { //[I-S]LN=37;[I-E]
      genData.dirtLayerHeight = grassLayerHeight; //[I-S]LN=38;[I-E]
      genData.beachLevel = minimalGroundHeight + 4; //[I-S]LN=39;[I-E]
      genData.seed = seed; //[I-S]LN=40;[I-E]
      genData.start(); //[I-S]LN=41;[I-E]
      generators.add(new CaveGenerator()); //[I-S]LN=42;[I-E]
      generators.add(new TreeGenerator()); //[I-S]LN=43;[I-E]
      generators.add(new SurfaceGenerator()); //[I-S]LN=44;[I-E]
 //[I-S]LN=45;[I-E]
      for (Generator gen : generators) { //[I-S]LN=46;[I-E]
        gen.start(); //[I-S]LN=47;[I-E]
      } //[I-S]LN=48;[I-E]
 //[I-S]LN=49;[I-E]
      started = true; //[I-S]LN=50;[I-E]
    } //[I-S]LN=51;[I-E]
  } //[I-S]LN=52;[I-E]
 //[I-S]LN=53;[I-E]
  @Override //[I-S]LN=54;[I-E]
  public void storeChunk(OH3LevelIntArray chunk, int x, int z) { //[I-S]LN=55;[I-E]
    start(); //[I-S]LN=56;[I-E]
  } //[I-S]LN=57;[I-E]
 //[I-S]LN=58;[I-E]
  @Override //[I-S]LN=59;[I-E]
  public OH3LevelIntArray loadChunk(int x, int z) { //[I-S]LN=60;[I-E]
    start(); //[I-S]LN=61;[I-E]
    return null; //[I-S]LN=62;[I-E]
  } //[I-S]LN=63;[I-E]
 //[I-S]LN=64;[I-E]
  @Override //[I-S]LN=65;[I-E]
  public int getGroundHeight(int x, int z) { //[I-S]LN=66;[I-E]
    start(); //[I-S]LN=67;[I-E]
    return genData.getGroundHeight(x, z, minimalGroundHeight, maxHillHeight, baseHillWidth); //[I-S]LN=68;[I-E]
  } //[I-S]LN=69;[I-E]
 //[I-S]LN=70;[I-E]
  @Override //[I-S]LN=71;[I-E]
  public int getBlockType(int x, int y, int z, int groundHeight) { //[I-S]LN=72;[I-E]
    start(); //[I-S]LN=73;[I-E]
 //[I-S]LN=74;[I-E]
    for (int a = 0; a < generators.size(); a++) { //[I-S]LN=75;[I-E]
      Generator g = generators.get(a); //[I-S]LN=76;[I-E]
      int t = g.getBlockType(x, y, z, groundHeight, genData); //[I-S]LN=77;[I-E]
      if (t >= 0) { //[I-S]LN=78;[I-E]
        return t; //[I-S]LN=79;[I-E]
      } //[I-S]LN=80;[I-E]
    } //[I-S]LN=81;[I-E]
 //[I-S]LN=82;[I-E]
    return Blocks.AIR; //[I-S]LN=83;[I-E]
  } //[I-S]LN=84;[I-E]
 //[I-S]LN=85;[I-E]
  @Override //[I-S]LN=86;[I-E]
  public boolean drawFace(int blockType, int sideBlockType, VoxelGeneratorListener.Direction sideFace, Point3 internalCoords) { //[I-S]LN=87;[I-E]
    if (sideBlockType == Blocks.LEAVES) return true; //[I-S]LN=88;[I-E]
 //[I-S]LN=89;[I-E]
    return sideBlockType == Blocks.AIR; //[I-S]LN=90;[I-E]
  } //[I-S]LN=91;[I-E]
 //[I-S]LN=92;[I-E]
  @Override //[I-S]LN=93;[I-E]
  public int getTextureIndex(int blockType, VoxelGeneratorListener.Direction dir, VoxelGeneratorListener.Direction face) { //[I-S]LN=94;[I-E]
    try { //[I-S]LN=95;[I-E]
      Block block = blocks.blocks.get(blockType); //[I-S]LN=96;[I-E]
      switch (face) { //[I-S]LN=97;[I-E]
        case UP: //[I-S]LN=98;[I-E]
          return block.topFace; //[I-S]LN=99;[I-E]
        case DOWN: //[I-S]LN=100;[I-E]
          return block.bottomFace; //[I-S]LN=101;[I-E]
        default: //[I-S]LN=102;[I-E]
          return block.sideFace; //[I-S]LN=103;[I-E]
      } //[I-S]LN=104;[I-E]
    } catch (Exception e) { //[I-S]LN=105;[I-E]
      Terminal.log(e.getMessage()); //[I-S]LN=106;[I-E]
      return (16*16)-1; //[I-S]LN=107;[I-E]
    }  //[I-S]LN=108;[I-E]
  } //[I-S]LN=109;[I-E]
} //[I-S]LN=110;[I-E]