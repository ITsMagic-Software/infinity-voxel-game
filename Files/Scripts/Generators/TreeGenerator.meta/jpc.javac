
 //[I-S]LN=1;[I-E]
// Useful imports //[I-S]LN=2;[I-E]
import java.util.*; //[I-S]LN=3;[I-E]
import java.text.*; //[I-S]LN=4;[I-E]
import java.net.*; //[I-S]LN=5;[I-E]
import java.math.*; //[I-S]LN=6;[I-E]
import java.io.*; //[I-S]LN=7;[I-E]
import java.nio.*; //[I-S]LN=8;[I-E]
 //[I-S]LN=9;[I-E]
/** @Author */ //[I-S]LN=10;[I-E]
class TreeGenerator extends Generator { //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  public int minTreeHeight = 3; //[I-S]LN=13;[I-E]
  public int maxTreeHeight = 5; //[I-S]LN=14;[I-E]
  public int treeWidth = 4; //[I-S]LN=15;[I-E]
 //[I-S]LN=16;[I-E]
  private PatternGenerator treePattern; //[I-S]LN=17;[I-E]
  private VegetationGenerator vegetation = new VegetationGenerator(); //[I-S]LN=18;[I-E]
 //[I-S]LN=19;[I-E]
  @Override //[I-S]LN=20;[I-E]
  public void start() { //[I-S]LN=21;[I-E]
    createTreePattern(); //[I-S]LN=22;[I-E]
  } //[I-S]LN=23;[I-E]
 //[I-S]LN=24;[I-E]
  /// Run only once //[I-S]LN=25;[I-E]
  @Override //[I-S]LN=26;[I-E]
  public int getBlockType(int x, int y, int z, int groundHeight, GenData data) { //[I-S]LN=27;[I-E]
 //[I-S]LN=28;[I-E]
    if (y <= groundHeight) { //[I-S]LN=29;[I-E]
      return -1; //[I-S]LN=30;[I-E]
    } //[I-S]LN=31;[I-E]
 //[I-S]LN=32;[I-E]
    int[] anchor = findTreeAnchor(x, z); //[I-S]LN=33;[I-E]
    if (anchor == null) { //[I-S]LN=34;[I-E]
      return -1; //[I-S]LN=35;[I-E]
    } //[I-S]LN=36;[I-E]
 //[I-S]LN=37;[I-E]
    int anchorX = anchor[0]; //[I-S]LN=38;[I-E]
    int anchorZ = anchor[1]; //[I-S]LN=39;[I-E]
    if (!vegetation.shouldPlaceTree(anchorX, anchorZ, groundHeight, data)) { //[I-S]LN=40;[I-E]
      return -1; //[I-S]LN=41;[I-E]
    } //[I-S]LN=42;[I-E]
 //[I-S]LN=43;[I-E]
    int th = data.getTreeHeight(anchorX, anchorZ, minTreeHeight, maxTreeHeight); //[I-S]LN=44;[I-E]
    int radius = data.getTreeRadius(anchorX, anchorZ, treeWidth / 2); //[I-S]LN=45;[I-E]
    int lh = radius + 2; //[I-S]LN=46;[I-E]
 //[I-S]LN=47;[I-E]
    Color pixel = treePattern.getInfinityPixel(x, z); //[I-S]LN=48;[I-E]
    if (y <= groundHeight + th) { //[I-S]LN=49;[I-E]
      float r = pixel.getFloatRed(); //[I-S]LN=50;[I-E]
      if (r > 0) { //[I-S]LN=51;[I-E]
        return Blocks.LOG; //[I-S]LN=52;[I-E]
      } //[I-S]LN=53;[I-E]
    } else if (y >= groundHeight + th && y <= groundHeight + th + lh) { //[I-S]LN=54;[I-E]
      float g = pixel.getFloatGreen(); //[I-S]LN=55;[I-E]
      int leafLevel = y - (groundHeight + th); //[I-S]LN=56;[I-E]
      int crownRadius = radius; //[I-S]LN=57;[I-E]
      if (leafLevel == 0 || leafLevel == lh) { //[I-S]LN=58;[I-E]
        crownRadius = java.lang.Math.max(1, radius - 1); //[I-S]LN=59;[I-E]
      } //[I-S]LN=60;[I-E]
 //[I-S]LN=61;[I-E]
      if (g > 0 && isInsideCrown(x, z, anchorX, anchorZ, crownRadius)) { //[I-S]LN=62;[I-E]
        return Blocks.LEAVES; //[I-S]LN=63;[I-E]
      } else { //[I-S]LN=64;[I-E]
        float r = pixel.getFloatRed(); //[I-S]LN=65;[I-E]
        if (r > 0) { //[I-S]LN=66;[I-E]
          return Blocks.LEAVES; //[I-S]LN=67;[I-E]
        }  //[I-S]LN=68;[I-E]
      } //[I-S]LN=69;[I-E]
    } //[I-S]LN=70;[I-E]
    return -1; //[I-S]LN=71;[I-E]
  } //[I-S]LN=72;[I-E]
 //[I-S]LN=73;[I-E]
  int[] findTreeAnchor(int x, int z) { //[I-S]LN=74;[I-E]
    Color center = treePattern.getInfinityPixel(x, z); //[I-S]LN=75;[I-E]
    if (center.getFloatRed() > 0f) { //[I-S]LN=76;[I-E]
      return new int[] { x, z }; //[I-S]LN=77;[I-E]
    } //[I-S]LN=78;[I-E]
 //[I-S]LN=79;[I-E]
    int searchRadius = java.lang.Math.max(1, treeWidth); //[I-S]LN=80;[I-E]
    int bestX = 0; //[I-S]LN=81;[I-E]
    int bestZ = 0; //[I-S]LN=82;[I-E]
    int bestDistance = 999999; //[I-S]LN=83;[I-E]
    for (int tx = x - searchRadius; tx <= x + searchRadius; tx++) { //[I-S]LN=84;[I-E]
      for (int tz = z - searchRadius; tz <= z + searchRadius; tz++) { //[I-S]LN=85;[I-E]
        Color pixel = treePattern.getInfinityPixel(tx, tz); //[I-S]LN=86;[I-E]
        if (pixel.getFloatRed() > 0f) { //[I-S]LN=87;[I-E]
          int dx = tx - x; //[I-S]LN=88;[I-E]
          int dz = tz - z; //[I-S]LN=89;[I-E]
          int distance = dx * dx + dz * dz; //[I-S]LN=90;[I-E]
          if (distance < bestDistance) { //[I-S]LN=91;[I-E]
            bestDistance = distance; //[I-S]LN=92;[I-E]
            bestX = tx; //[I-S]LN=93;[I-E]
            bestZ = tz; //[I-S]LN=94;[I-E]
          } //[I-S]LN=95;[I-E]
        } //[I-S]LN=96;[I-E]
      } //[I-S]LN=97;[I-E]
    } //[I-S]LN=98;[I-E]
 //[I-S]LN=99;[I-E]
    if (bestDistance < 999999) { //[I-S]LN=100;[I-E]
      return new int[] { bestX, bestZ }; //[I-S]LN=101;[I-E]
    } //[I-S]LN=102;[I-E]
    return null; //[I-S]LN=103;[I-E]
  } //[I-S]LN=104;[I-E]
 //[I-S]LN=105;[I-E]
  boolean isInsideCrown(int x, int z, int anchorX, int anchorZ, int crownRadius) { //[I-S]LN=106;[I-E]
    int dx = x - anchorX; //[I-S]LN=107;[I-E]
    int dz = z - anchorZ; //[I-S]LN=108;[I-E]
    return dx * dx + dz * dz <= crownRadius * crownRadius; //[I-S]LN=109;[I-E]
  } //[I-S]LN=110;[I-E]
 //[I-S]LN=111;[I-E]
  void createTreePattern() { //[I-S]LN=112;[I-E]
    int r = 128; //[I-S]LN=113;[I-E]
    treePattern = new PatternGenerator(r); //[I-S]LN=114;[I-E]
    treePattern.setScale(5f); //[I-S]LN=115;[I-E]
    treePattern.setMargin(0.2f); //[I-S]LN=116;[I-E]
    treePattern.build(); //[I-S]LN=117;[I-E]
    int leavesWidth = (int) java.lang.Math.ceil(treeWidth / 2f); //[I-S]LN=118;[I-E]
 //[I-S]LN=119;[I-E]
    for (int x = 0; x < r; x++) { //[I-S]LN=120;[I-E]
      for (int y = 0; y < r; y++) { //[I-S]LN=121;[I-E]
        Color pixel = treePattern.getDirectPixel(x, y); //[I-S]LN=122;[I-E]
 //[I-S]LN=123;[I-E]
        float v = pixel.getFloatRed(); //[I-S]LN=124;[I-E]
        if (v <= 0) { //[I-S]LN=125;[I-E]
 //[I-S]LN=126;[I-E]
          squareLoop: //[I-S]LN=127;[I-E]
          { //[I-S]LN=128;[I-E]
            for (int x2 = x - leavesWidth; x2 < x + leavesWidth; x2++) { //[I-S]LN=129;[I-E]
              for (int y2 = y - leavesWidth; y2 < y + leavesWidth; y2++) { //[I-S]LN=130;[I-E]
                if (x2 > 0 && x2 < r) { //[I-S]LN=131;[I-E]
                  if (y2 > 0 && y2 < r) { //[I-S]LN=132;[I-E]
                    v = detectSideRed(treePattern, v, x2, y2); //[I-S]LN=133;[I-E]
                    if (v > 0) { //[I-S]LN=134;[I-E]
                      break squareLoop; //[I-S]LN=135;[I-E]
                    } //[I-S]LN=136;[I-E]
                  } //[I-S]LN=137;[I-E]
                } //[I-S]LN=138;[I-E]
              } //[I-S]LN=139;[I-E]
            } //[I-S]LN=140;[I-E]
          } //[I-S]LN=141;[I-E]
 //[I-S]LN=142;[I-E]
          if (v > 0) { //[I-S]LN=143;[I-E]
            pixel.setFloats(0, 1, 0); //[I-S]LN=144;[I-E]
            treePattern.setDirectPixel(x, y, pixel); //[I-S]LN=145;[I-E]
          } //[I-S]LN=146;[I-E]
        } else { //[I-S]LN=147;[I-E]
          pixel.setFloats(1, 0, 0); //[I-S]LN=148;[I-E]
          treePattern.setDirectPixel(x, y, pixel); //[I-S]LN=149;[I-E]
        } //[I-S]LN=150;[I-E]
      } //[I-S]LN=151;[I-E]
    } //[I-S]LN=152;[I-E]
    treePattern.getTexture().apply(); //[I-S]LN=153;[I-E]
  } //[I-S]LN=154;[I-E]
 //[I-S]LN=155;[I-E]
  float detectSideRed(PatternGenerator p, float v, int x, int y) { //[I-S]LN=156;[I-E]
    if (v > 0) return v; //[I-S]LN=157;[I-E]
    Color c = p.getDirectPixel(x, y); //[I-S]LN=158;[I-E]
    if (c.getFloatRed() > 0f) { //[I-S]LN=159;[I-E]
      v = 1; //[I-S]LN=160;[I-E]
    } //[I-S]LN=161;[I-E]
    return v; //[I-S]LN=162;[I-E]
  } //[I-S]LN=163;[I-E]
} //[I-S]LN=164;[I-E]