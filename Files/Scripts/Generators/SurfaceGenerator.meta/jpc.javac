
 //[I-S]LN=1;[I-E]
// Useful imports //[I-S]LN=2;[I-E]
import java.util.*; //[I-S]LN=3;[I-E]
import java.text.*; //[I-S]LN=4;[I-E]
import java.net.*; //[I-S]LN=5;[I-E]
import java.math.*; //[I-S]LN=6;[I-E]
import java.io.*; //[I-S]LN=7;[I-E]
import java.nio.*; //[I-S]LN=8;[I-E]
 //[I-S]LN=9;[I-E]
/** @Author */ //[I-S]LN=10;[I-E]
class SurfaceGenerator extends Generator { //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  @Override //[I-S]LN=13;[I-E]
  public int getBlockType(int x, int y, int z, int groundHeight, GenData data) { //[I-S]LN=14;[I-E]
    if (y > groundHeight) { //[I-S]LN=15;[I-E]
      return Blocks.AIR; //[I-S]LN=16;[I-E]
    } //[I-S]LN=17;[I-E]
 //[I-S]LN=18;[I-E]
    int biome = data.getBiome(x, z, groundHeight); //[I-S]LN=19;[I-E]
    int depth = groundHeight - y; //[I-S]LN=20;[I-E]
 //[I-S]LN=21;[I-E]
    if (biome == BiomeGenerator.BEACH || biome == BiomeGenerator.DESERT) { //[I-S]LN=22;[I-E]
      if (depth <= data.beachDepth || y >= groundHeight - data.dirtLayerHeight) { //[I-S]LN=23;[I-E]
        return Blocks.SAND; //[I-S]LN=24;[I-E]
      } //[I-S]LN=25;[I-E]
      return Blocks.ROCK; //[I-S]LN=26;[I-E]
    } //[I-S]LN=27;[I-E]
 //[I-S]LN=28;[I-E]
    if (biome == BiomeGenerator.MOUNTAINS && depth <= 1) { //[I-S]LN=29;[I-E]
      return Blocks.ROCK; //[I-S]LN=30;[I-E]
    } //[I-S]LN=31;[I-E]
 //[I-S]LN=32;[I-E]
    if (depth == 0) { //[I-S]LN=33;[I-E]
      return Blocks.GRASS; //[I-S]LN=34;[I-E]
    } //[I-S]LN=35;[I-E]
    if (depth <= data.dirtLayerHeight) { //[I-S]LN=36;[I-E]
      return Blocks.DIRT; //[I-S]LN=37;[I-E]
    } //[I-S]LN=38;[I-E]
    return Blocks.ROCK; //[I-S]LN=39;[I-E]
  } //[I-S]LN=40;[I-E]
} //[I-S]LN=41;[I-E]