// Useful imports //[I-S]LN=2;[I-E]
import java.util.*; //[I-S]LN=3;[I-E]
import java.text.*; //[I-S]LN=4;[I-E]
import java.net.*; //[I-S]LN=5;[I-E]
import java.math.*; //[I-S]LN=6;[I-E]
import java.io.*; //[I-S]LN=7;[I-E]
import java.nio.*; //[I-S]LN=8;[I-E]
 //[I-S]LN=9;[I-E]
/** @Author */ //[I-S]LN=10;[I-E]
class BiomeGenerator extends Generator { //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  public static final int PLAINS = 0; //[I-S]LN=13;[I-E]
  public static final int FOREST = 1; //[I-S]LN=14;[I-E]
  public static final int DESERT = 2; //[I-S]LN=15;[I-E]
  public static final int BEACH = 3; //[I-S]LN=16;[I-E]
  public static final int MOUNTAINS = 4; //[I-S]LN=17;[I-E]
 //[I-S]LN=18;[I-E]
  public int getBiome(float moisture, float temperature, int groundHeight, int beachLevel) { //[I-S]LN=19;[I-E]
    if (groundHeight <= beachLevel) { //[I-S]LN=20;[I-E]
      return BEACH; //[I-S]LN=21;[I-E]
    } //[I-S]LN=22;[I-E]
    if (groundHeight >= beachLevel + 24) { //[I-S]LN=23;[I-E]
      return MOUNTAINS; //[I-S]LN=24;[I-E]
    } //[I-S]LN=25;[I-E]
    if (temperature > 0.62f && moisture < 0.38f) { //[I-S]LN=26;[I-E]
      return DESERT; //[I-S]LN=27;[I-E]
    } //[I-S]LN=28;[I-E]
    if (moisture > 0.52f) { //[I-S]LN=29;[I-E]
      return FOREST; //[I-S]LN=30;[I-E]
    } //[I-S]LN=31;[I-E]
    return PLAINS; //[I-S]LN=32;[I-E]
  } //[I-S]LN=33;[I-E]
} //[I-S]LN=34;[I-E]