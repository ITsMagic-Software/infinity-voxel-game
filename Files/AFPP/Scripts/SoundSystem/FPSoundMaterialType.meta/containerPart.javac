 //[I-S]LN=1;[I-E]
// Useful imports //[I-S]LN=2;[I-E]
 //[I-S]LN=9;[I-E]
/** @Author */ //[I-S]LN=10;[I-E]
class PatternGenerator { //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  private Texture texture; //[I-S]LN=13;[I-E]
  private int resolution; //[I-S]LN=14;[I-E]
  private float scale; //[I-S]LN=15;[I-E]
  private float margin = 0.1f; //[I-S]LN=16;[I-E]
 //[I-S]LN=17;[I-E]
  private float offsetX = 0; //[I-S]LN=18;[I-E]
  private float offsetY = 0; //[I-S]LN=19;[I-E]
 //[I-S]LN=20;[I-E]
  public PatternGenerator(int resolution) { //[I-S]LN=21;[I-E]
    setResolution(resolution); //[I-S]LN=22;[I-E]
  } //[I-S]LN=23;[I-E]
 //[I-S]LN=24;[I-E]
  public PatternGenerator(int resolution, float scale, float margin) { //[I-S]LN=25;[I-E]
    setResolution(resolution); //[I-S]LN=26;[I-E]
    setMargin(margin); //[I-S]LN=27;[I-E]
    setScale(scale); //[I-S]LN=28;[I-E]
  } //[I-S]LN=29;[I-E]
 //[I-S]LN=30;[I-E]
  public void setResolution(int r) { //[I-S]LN=31;[I-E]
    if (r <= 0) throw new RuntimeException("Invalid resolution"); //[I-S]LN=32;[I-E]
    this.resolution = r; //[I-S]LN=33;[I-E]
  } //[I-S]LN=34;[I-E]
 //[I-S]LN=35;[I-E]
  public void setScale(float s) { //[I-S]LN=36;[I-E]
    if (s <= 0) throw new RuntimeException("Invalid scale"); //[I-S]LN=37;[I-E]
    this.scale = s; //[I-S]LN=38;[I-E]
  } //[I-S]LN=39;[I-E]
 //[I-S]LN=40;[I-E]
  public void setMargin(float m) { //[I-S]LN=41;[I-E]
    if (m <= 0 || m > 1) throw new RuntimeException("Invalid margin"); //[I-S]LN=42;[I-E]
    this.margin = m; //[I-S]LN=43;[I-E]
  } //[I-S]LN=44;[I-E]
 //[I-S]LN=45;[I-E]
  public void setOffsets(float x, float y) { //[I-S]LN=46;[I-E]
    this.offsetX = x; //[I-S]LN=47;[I-E]
    this.offsetY = y; //[I-S]LN=48;[I-E]
  } //[I-S]LN=49;[I-E]
 //[I-S]LN=50;[I-E]
  public void build() { //[I-S]LN=51;[I-E]
    PerlinNoise pn = new PerlinNoise(scale); //[I-S]LN=52;[I-E]
 //[I-S]LN=53;[I-E]
    texture = new Texture(resolution, resolution); //[I-S]LN=54;[I-E]
    Color color = new Color(); //[I-S]LN=55;[I-E]
    color.setFloats(0, 0, 0); //[I-S]LN=56;[I-E]
    for (int x = 0; x < resolution; x++) { //[I-S]LN=57;[I-E]
      for (int y = 0; y < resolution; y++) { //[I-S]LN=58;[I-E]
        texture.setPixel(x, y, color); //[I-S]LN=59;[I-E]
      } //[I-S]LN=60;[I-E]
    } //[I-S]LN=61;[I-E]
    texture.apply(); //[I-S]LN=62;[I-E]
 //[I-S]LN=63;[I-E]
    for (int x = 0; x < resolution; x++) { //[I-S]LN=64;[I-E]
      for (int y = 0; y < resolution; y++) { //[I-S]LN=65;[I-E]
        float v = pn.noise(offsetX + x, offsetY + y); //[I-S]LN=66;[I-E]
        if (v < -1 + margin || v > 1 - margin) { //[I-S]LN=67;[I-E]
          v = 1f; //[I-S]LN=68;[I-E]
        } else { //[I-S]LN=69;[I-E]
          v = 0f; //[I-S]LN=70;[I-E]
        } //[I-S]LN=71;[I-E]
        v = fixSideColor(v, x - 1, y - 1); //[I-S]LN=72;[I-E]
        v = fixSideColor(v, x, y - 1); //[I-S]LN=73;[I-E]
        v = fixSideColor(v, x - 1, y); //[I-S]LN=74;[I-E]
        v = fixSideColor(v, x, y); //[I-S]LN=75;[I-E]
        v = fixSideColor(v, x + 1, y + 1); //[I-S]LN=76;[I-E]
        v = fixSideColor(v, x, y + 1); //[I-S]LN=77;[I-E]
        v = fixSideColor(v, x + 1, y); //[I-S]LN=78;[I-E]
        v = fixSideColor(v, x + 1, y - 1); //[I-S]LN=79;[I-E]
        v = fixSideColor(v, x - 1, y + 1); //[I-S]LN=80;[I-E]
         //[I-S]LN=81;[I-E]
 //[I-S]LN=82;[I-E]
        color.setFloats(v, v, v); //[I-S]LN=83;[I-E]
        texture.setPixel(x, y, color); //[I-S]LN=84;[I-E]
      } //[I-S]LN=85;[I-E]
    } //[I-S]LN=86;[I-E]
    texture.apply(); //[I-S]LN=87;[I-E]
  } //[I-S]LN=88;[I-E]
 //[I-S]LN=89;[I-E]
  float fixSideColor(float v, int x, int y) { //[I-S]LN=90;[I-E]
    if (v <= 0) return v; //[I-S]LN=91;[I-E]
    Color c = getDirectPixel(x, y); //[I-S]LN=92;[I-E]
    if (c.getFloatRed() > 0f) { //[I-S]LN=93;[I-E]
      v = 0; //[I-S]LN=94;[I-E]
    } //[I-S]LN=95;[I-E]
    return v; //[I-S]LN=96;[I-E]
  } //[I-S]LN=97;[I-E]
 //[I-S]LN=98;[I-E]
  public Color getDirectPixel(int x, int y) { //[I-S]LN=99;[I-E]
    int lx = x; //[I-S]LN=100;[I-E]
    lx = (int) Math.clamp(0, x, resolution - 1); //[I-S]LN=101;[I-E]
    int ly = y; //[I-S]LN=102;[I-E]
    ly = (int) Math.clamp(0, y, resolution - 1); //[I-S]LN=103;[I-E]
    return texture.getPixel(lx, ly); //[I-S]LN=104;[I-E]
  } //[I-S]LN=105;[I-E]
 //[I-S]LN=106;[I-E]
  public void setDirectPixel(int x, int y, Color color) { //[I-S]LN=107;[I-E]
    int lx = x; //[I-S]LN=108;[I-E]
    lx = (int) Math.clamp(0, x, resolution - 1); //[I-S]LN=109;[I-E]
    int ly = y; //[I-S]LN=110;[I-E]
    ly = (int) Math.clamp(0, y, resolution - 1); //[I-S]LN=111;[I-E]
    texture.setPixel(lx, ly, color); //[I-S]LN=112;[I-E]
  } //[I-S]LN=113;[I-E]
 //[I-S]LN=114;[I-E]
  public Texture getTexture() { //[I-S]LN=115;[I-E]
    return texture; //[I-S]LN=116;[I-E]
  } //[I-S]LN=117;[I-E]
 //[I-S]LN=118;[I-E]
  public Color getInfinityPixel(int x, int y) { //[I-S]LN=119;[I-E]
    int r = resolution; //[I-S]LN=120;[I-E]
    if (x > r) { //[I-S]LN=121;[I-E]
      float p = (float) x / (float) r; //[I-S]LN=122;[I-E]
      int ip = (int) p; //[I-S]LN=123;[I-E]
      p = p - ip; //[I-S]LN=124;[I-E]
      x = (int) (p * r); //[I-S]LN=125;[I-E]
    } //[I-S]LN=126;[I-E]
    if (y > r) { //[I-S]LN=127;[I-E]
      float p = (float) y / (float) r; //[I-S]LN=128;[I-E]
      int ip = (int) p; //[I-S]LN=129;[I-E]
      p = p - ip; //[I-S]LN=130;[I-E]
      y = (int) (p * r); //[I-S]LN=131;[I-E]
    } //[I-S]LN=132;[I-E]
    { //[I-S]LN=133;[I-E]
      if (x < 0) { //[I-S]LN=134;[I-E]
 //[I-S]LN=135;[I-E]
        float p = (float) x / (float) r; //[I-S]LN=136;[I-E]
        p = -p; //[I-S]LN=137;[I-E]
        int ip = (int) p; //[I-S]LN=138;[I-E]
        p = p - ip; //[I-S]LN=139;[I-E]
        p = 1f - p; //[I-S]LN=140;[I-E]
        x = (int) (p * r); //[I-S]LN=141;[I-E]
      } //[I-S]LN=142;[I-E]
      if (y < 0) { //[I-S]LN=143;[I-E]
        float p = (float) y / (float) r; //[I-S]LN=144;[I-E]
        p = -p; //[I-S]LN=145;[I-E]
        int ip = (int) p; //[I-S]LN=146;[I-E]
        p = p - ip; //[I-S]LN=147;[I-E]
        p = 1f - p; //[I-S]LN=148;[I-E]
        y = (int) (p * r); //[I-S]LN=149;[I-E]
      } //[I-S]LN=150;[I-E]
    } //[I-S]LN=151;[I-E]
    return getDirectPixel(x, y); //[I-S]LN=152;[I-E]
  } //[I-S]LN=153;[I-E]
 //[I-S]LN=154;[I-E]
  public float getInfinityRed(int x, int y) { //[I-S]LN=155;[I-E]
    return getInfinityPixel(x, y).getFloatRed(); //[I-S]LN=156;[I-E]
  } //[I-S]LN=157;[I-E]
 //[I-S]LN=158;[I-E]
  public float getInfinityGreen(int x, int y) { //[I-S]LN=159;[I-E]
    return getInfinityPixel(x, y).getFloatGreen(); //[I-S]LN=160;[I-E]
  }  //[I-S]LN=161;[I-E]
 //[I-S]LN=162;[I-E]
  public float getInfinityBlue(int x, int y) { //[I-S]LN=163;[I-E]
    return getInfinityPixel(x, y).getFloatBlue(); //[I-S]LN=164;[I-E]
  } //[I-S]LN=165;[I-E]
} //[I-S]LN=166;[I-E]
//C-R:VUtils

 //[I-S]LN=1;[I-E]
