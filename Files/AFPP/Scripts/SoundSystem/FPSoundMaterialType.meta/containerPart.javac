/** @Author */ //[I-S]LN=10;[I-E]
class TreeGenerator extends Generator { //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  public int minTreeHeight = 3; //[I-S]LN=13;[I-E]
  public int maxTreeHeight = 5; //[I-S]LN=14;[I-E]
  public int treeWidth = 4; //[I-S]LN=15;[I-E]
 //[I-S]LN=16;[I-E]
  private PatternGenerator treePattern; //[I-S]LN=17;[I-E]
 //[I-S]LN=18;[I-E]
  @Override //[I-S]LN=19;[I-E]
  public void start() { //[I-S]LN=20;[I-E]
    createTreePattern(); //[I-S]LN=21;[I-E]
    VUtils.debugPattern(treePattern); //[I-S]LN=22;[I-E]
  } //[I-S]LN=23;[I-E]
 //[I-S]LN=24;[I-E]
  /// Run only once //[I-S]LN=25;[I-E]
  @Override //[I-S]LN=26;[I-E]
  public int getBlockType(int x, int y, int z, int groundHeight, GenData data) { //[I-S]LN=27;[I-E]
 //[I-S]LN=28;[I-E]
    int th = minTreeHeight; //[I-S]LN=29;[I-E]
    int lh = 3; //[I-S]LN=30;[I-E]
    if (y > groundHeight) { //[I-S]LN=31;[I-E]
      Color pixel = treePattern.getInfinityPixel(x, z); //[I-S]LN=32;[I-E]
      if (y <= groundHeight + th) { //[I-S]LN=33;[I-E]
        float r = pixel.getFloatRed(); //[I-S]LN=34;[I-E]
        if (r > 0) { //[I-S]LN=35;[I-E]
          return Blocks.WOOD_SIDE; //[I-S]LN=36;[I-E]
        } //[I-S]LN=37;[I-E]
      } else if (y >= groundHeight + th && y <= groundHeight + th + lh) { //[I-S]LN=38;[I-E]
        float g = pixel.getFloatGreen(); //[I-S]LN=39;[I-E]
        if (g > 0) { //[I-S]LN=40;[I-E]
          return Blocks.LEAVES; //[I-S]LN=41;[I-E]
        } else { //[I-S]LN=42;[I-E]
          float r = pixel.getFloatRed(); //[I-S]LN=43;[I-E]
          if (r > 0) { //[I-S]LN=44;[I-E]
            return Blocks.LEAVES; //[I-S]LN=45;[I-E]
          }  //[I-S]LN=46;[I-E]
        } //[I-S]LN=47;[I-E]
      } //[I-S]LN=48;[I-E]
    } //[I-S]LN=49;[I-E]
    return -1; //[I-S]LN=50;[I-E]
  } //[I-S]LN=51;[I-E]
 //[I-S]LN=52;[I-E]
  void createTreePattern() { //[I-S]LN=53;[I-E]
    int r = 128; //[I-S]LN=54;[I-E]
    treePattern = new PatternGenerator(r); //[I-S]LN=55;[I-E]
    treePattern.setScale(5f); //[I-S]LN=56;[I-E]
    treePattern.setMargin(0.2f); //[I-S]LN=57;[I-E]
    treePattern.build(); //[I-S]LN=58;[I-E]
    int leavesWidth = (int) Math.ceil(treeWidth / 2f); //[I-S]LN=59;[I-E]
 //[I-S]LN=60;[I-E]
    for (int x = 0; x < r; x++) { //[I-S]LN=61;[I-E]
      for (int y = 0; y < r; y++) { //[I-S]LN=62;[I-E]
        Color pixel = treePattern.getDirectPixel(x, y); //[I-S]LN=63;[I-E]
 //[I-S]LN=64;[I-E]
        float v = pixel.getFloatRed(); //[I-S]LN=65;[I-E]
        if (v <= 0) { //[I-S]LN=66;[I-E]
 //[I-S]LN=67;[I-E]
          squareLoop: //[I-S]LN=68;[I-E]
          { //[I-S]LN=69;[I-E]
            for (int x2 = x - leavesWidth; x2 < x + leavesWidth; x2++) { //[I-S]LN=70;[I-E]
              for (int y2 = y - leavesWidth; y2 < y + leavesWidth; y2++) { //[I-S]LN=71;[I-E]
                if (x2 > 0 && x2 < r) { //[I-S]LN=72;[I-E]
                  if (y2 > 0 && y2 < r) { //[I-S]LN=73;[I-E]
                    v = detectSideRed(treePattern, v, x2, y2); //[I-S]LN=74;[I-E]
                    if (v > 0) { //[I-S]LN=75;[I-E]
                      break squareLoop; //[I-S]LN=76;[I-E]
                    } //[I-S]LN=77;[I-E]
                  } //[I-S]LN=78;[I-E]
                } //[I-S]LN=79;[I-E]
              } //[I-S]LN=80;[I-E]
            } //[I-S]LN=81;[I-E]
          } //[I-S]LN=82;[I-E]
 //[I-S]LN=83;[I-E]
          if (v > 0) { //[I-S]LN=84;[I-E]
            pixel.setFloats(0, 1, 0); //[I-S]LN=85;[I-E]
            treePattern.setDirectPixel(x, y, pixel); //[I-S]LN=86;[I-E]
          } //[I-S]LN=87;[I-E]
        } else { //[I-S]LN=88;[I-E]
          pixel.setFloats(1, 0, 0); //[I-S]LN=89;[I-E]
          treePattern.setDirectPixel(x, y, pixel); //[I-S]LN=90;[I-E]
        } //[I-S]LN=91;[I-E]
      } //[I-S]LN=92;[I-E]
    } //[I-S]LN=93;[I-E]
    treePattern.getTexture().apply(); //[I-S]LN=94;[I-E]
  } //[I-S]LN=95;[I-E]
 //[I-S]LN=96;[I-E]
  float detectSideRed(PatternGenerator p, float v, int x, int y) { //[I-S]LN=97;[I-E]
    if (v > 0) return v; //[I-S]LN=98;[I-E]
    Color c = p.getDirectPixel(x, y); //[I-S]LN=99;[I-E]
    if (c.getFloatRed() > 0f) { //[I-S]LN=100;[I-E]
      v = 1; //[I-S]LN=101;[I-E]
    } //[I-S]LN=102;[I-E]
    return v; //[I-S]LN=103;[I-E]
  } //[I-S]LN=104;[I-E]
} //[I-S]LN=105;[I-E]
