    public static final int GRASS = 1; //[I-S]LN=16;[I-E]
    public static final int ROCK = 2; //[I-S]LN=17;[I-E]
    public static final int WOOD_SIDE = 4; //[I-S]LN=18;[I-E]
    public static final int WOOD_TOP = 5; //[I-S]LN=19;[I-E]
